# ─── Sanity CMS ───────────────────────────────────────────────
# Dobiti na: https://sanity.io/manage → projekt → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Read-only token (server-only — NIKAD ne dodavati NEXT_PUBLIC_ prefiks)
SANITY_API_TOKEN=your_read_only_token
# Webhook secret za ISR revalidaciju (generisati: openssl rand -hex 32)
SANITY_WEBHOOK_SECRET=your_webhook_secret

# ─── Auth.js (CMS login zaštita) ──────────────────────────────
# Generisati: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_min_32_chars
# Kredencijali za /login pristup Sanity Studiju
ADMIN_EMAIL=admin@naxitaxibb.rs
# Generisati bcrypt hash: node -e "const b=require('bcryptjs');console.log(b.hashSync('yourpassword',12))"
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password

# ─── Email (Resend) ───────────────────────────────────────────
# Dobiti na: https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key
# Email adresa na koju stižu upiti sa formi
CONTACT_EMAIL=info@naxitaxibb.rs

# ─── Analytics ────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# ─── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
